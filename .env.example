# Variables de entorno — copiar a .env y completar. NUNCA commitear valores reales.

# Conexión PostgreSQL (en Railway la provee el plugin de PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:5432/base"

# Zona horaria del proceso (fechas "clases de hoy")
TZ="America/Argentina/Buenos_Aires"

# URL pública de la app (para links absolutos si hicieran falta)
APP_URL="http://localhost:3000"

# Credenciales del PRIMER usuario administrador, usadas solo por el seed.
# En producción: setearlas, correr el seed una vez y luego eliminarlas.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Puerto (Railway lo inyecta automáticamente)
# PORT=3000
